{
  "name": "frontend-techstack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run sync && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc -b && node scripts/validate.mjs && node --test tests/*.test.mjs",
    "sync": "node scripts/sync.mjs",
    "format": "prettier --write src scripts tests vite.config.ts tsconfig.json package.json index.html .github/workflows/deploy.yml",
    "update:metrics": "node scripts/update-metrics.mjs && npm run sync"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "license": "MIT"
}
